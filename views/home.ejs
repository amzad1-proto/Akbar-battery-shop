<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Battery Shop | Akbar battery & Automobiles</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50">

    <!-- Navigation Bar -->
    <nav class="bg-white shadow-lg p-4 sticky top-0 z-50">
        <div class="container mx-auto flex justify-between items-center">
            <h1 class="text-2xl font-bold text-green-600 italic">Akbar battery <span class="text-gray-800">&
                    Automobiles</span>
            </h1>
            <div class="space-x-6 font-semibold">
                <a href="/" class="hover:text-green-600">Home</a>
                <a href="/products" class="hover:text-green-600">Products</a>
                <a href="/about" class="hover:text-green-600">About Us</a>
                <a href="/contact" class="hover:text-green-600">Contact</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <header class="bg-gradient-to-r from-green-500 to-green-700 text-white py-20 px-6 text-center">
        <h2 class="text-5xl font-extrabold mb-4">Reliable Power for Every Journey</h2>
        <p class="text-xl mb-8">Authorized Dealer of Amaron & Powerzone Batteries in Sathupally.</p>
        <div class="flex justify-center space-x-4">
            <a href="/products"
                class="bg-white text-green-700 px-8 py-3 rounded-full font-bold hover:bg-gray-100">Browse Inventory</a>
            <a href="/contact"
                class="border-2 border-white px-8 py-3 rounded-full font-bold hover:bg-white hover:text-green-700">Get a
                Quote</a>
        </div>
    </header>

    <!-- Categories Section -->
    <section class="container mx-auto py-16 px-4">
        <h3 class="text-3xl font-bold text-center mb-12">Our Specialized Sections</h3>
        <div class="grid md:grid-cols-3 gap-8 text-center">
            <!-- Vehicles -->
            <div class="bg-white p-8 rounded-xl shadow-md border-b-4 border-green-500">
                <div class="text-4xl mb-4">🚗</div>
                <h4 class="text-xl font-bold mb-2">Automotive Batteries</h4>
                <p class="text-gray-600">Long-lasting power for cars, bikes, and heavy commercial vehicles.</p>
            </div>
            <!-- Inverters -->
            <div class="bg-white p-8 rounded-xl shadow-md border-b-4 border-green-500">
                <div class="text-4xl mb-4">🏠</div>
                <h4 class="text-xl font-bold mb-2">Home Inverters</h4>
                <p class="text-gray-600">Uninterrupted power supply for your home and office needs.</p>
            </div>
            <!-- Lubricants -->
            <div class="bg-white p-8 rounded-xl shadow-md border-b-4 border-green-500">
                <div class="text-4xl mb-4">🛢️</div>
                <h4 class="text-xl font-bold mb-2">Premium Lubricants</h4>
                <p class="text-gray-600">Engine oils and fluids to keep your machinery running smooth.</p>
            </div>
        </div>
    </section>

</body>

</html>