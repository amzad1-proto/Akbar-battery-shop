<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Akbar Battery & Automobiles | Authorized Distributor</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .glass-nav {
            backdrop-filter: blur(20px);
            background: rgba(255, 255, 255, 0.9);
        }

        .hero-gradient {
            background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
        }

        .fade-up {
            animation: fadeUp 0.8s ease-out;
        }

        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>

<body class="bg-white text-slate-900">

    <!-- 1. NAVIGATION -->
    <nav class="glass-nav sticky top-0 z-[100] border-b border-slate-100 px-6 py-4">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <h1 class="text-xl font-extrabold tracking-tighter text-slate-900">
                AKBAR <span class="text-green-700">BATTERY</span>
            </h1>
            <div class="hidden md:flex space-x-10 text-sm font-semibold uppercase tracking-widest text-slate-500">
                <a href="/" class="text-slate-900 border-b-2 border-slate-900 pb-1">Home</a>
                <a href="/products" class="hover:text-green-700 transition-colors">Inventory</a>
                <a href="/about" class="hover:text-green-700 transition-colors">About</a>
                <a href="/contact" class="hover:text-green-700 transition-colors">Contact</a>
            </div>
        </div>
    </nav>

    <!-- 2. CORPORATE HERO SECTION -->
    <section class="hero-gradient py-24 md:py-40 px-6 border-b border-slate-100">
        <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-12 items-center">
            <div class="fade-up">
                <span class="text-xs font-bold uppercase tracking-[0.3em] text-green-700 mb-4 block">Official
                    Distribution Partner</span>
                <h2 class="text-5xl md:text-7xl font-extrabold tracking-tight text-slate-900 mb-8 leading-[1.1]">
                    Advanced Energy <br> Solutions.
                </h2>
                <p class="text-slate-500 text-xl max-w-lg mb-10 leading-relaxed">
                    Sathupally's premier technical hub for Amaron & Powerzone technologies. We provide industrial-grade
                    power for automotive and domestic applications.
                </p>
                <div class="flex flex-col sm:flex-row gap-4">
                    <a href="/products"
                        class="bg-slate-900 text-white px-10 py-4 rounded font-bold text-xs uppercase tracking-widest hover:bg-green-800 transition-all text-center">
                        View Inventory
                    </a>
                    <a href="/contact"
                        class="border border-slate-200 px-10 py-4 rounded font-bold text-xs uppercase tracking-widest hover:bg-slate-50 transition-all text-center">
                        Technical Support
                    </a>
                </div>
            </div>

            <!-- FIXED IMAGE SECTION WITH YOUR SHOP PHOTO -->
            <div class="hidden md:block relative">
                <div class="absolute -inset-4 bg-green-700/10 rounded-full blur-3xl"></div>
                <img src="/uploads/shop-front.jpeg"
                    class="relative z-10 w-full rounded-2xl shadow-2xl grayscale-[10%] hover:grayscale-0 transition-all duration-700 border border-slate-200"
                    alt="Akbar Battery & Automobiles Shop Front">
            </div>
        </div>
    </section>

    <!-- 3. CAPABILITIES / SECTIONS -->
    <section class="py-24 px-6 bg-white">
        <div class="max-w-7xl mx-auto">
            <div class="mb-20">
                <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400 mb-4">Core Competencies</h3>
                <h4 class="text-3xl font-bold text-slate-900">Industrial & Consumer Specializations</h4>
            </div>

            <div class="grid md:grid-cols-3 gap-16">
                <!-- Automotive -->
                <div class="group">
                    <div class="text-3xl mb-6 text-slate-300 group-hover:text-green-700 transition-colors">01</div>
                    <h5 class="text-xl font-bold mb-4">Automotive Solutions</h5>
                    <p class="text-slate-500 leading-relaxed mb-6">High-crank power delivery for heavy-duty commercial
                        mining vehicles and passenger transport.</p>
                    <a href="/products"
                        class="text-xs font-bold uppercase tracking-widest text-slate-900 border-b-2 border-slate-900 pb-1">Explore
                        Range</a>
                </div>
                <!-- Power Backup -->
                <div class="group">
                    <div class="text-3xl mb-6 text-slate-300 group-hover:text-green-700 transition-colors">02</div>
                    <h5 class="text-xl font-bold mb-4">Energy Storage</h5>
                    <p class="text-slate-500 leading-relaxed mb-6">Advanced inverter technologies for uninterrupted
                        domestic and commercial power supply management.</p>
                    <a href="/products"
                        class="text-xs font-bold uppercase tracking-widest text-slate-900 border-b-2 border-slate-900 pb-1">Explore
                        Range</a>
                </div>
                <!-- Lubricants -->
                <div class="group">
                    <div class="text-3xl mb-6 text-slate-300 group-hover:text-green-700 transition-colors">03</div>
                    <h5 class="text-xl font-bold mb-4">Machinery Care</h5>
                    <p class="text-slate-500 leading-relaxed mb-6">Premium synthetic lubricants designed to optimize
                        mechanical efficiency and engine longevity.</p>
                    <a href="/products"
                        class="text-xs font-bold uppercase tracking-widest text-slate-900 border-b-2 border-slate-900 pb-1">Explore
                        Range</a>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. LOCATION CALLOUT -->
    <section class="py-24 px-6 bg-slate-50">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-12">
            <div>
                <h4 class="text-3xl font-bold mb-4 tracking-tight">Sathupally Technical Center</h4>
                <p class="text-slate-500 max-w-md">Our T.P.R Residency facility is equipped for professional battery
                    health diagnostics and lubricant consultation.</p>
            </div>
            <div class="flex gap-8 items-center">
                <div class="text-center">
                    <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-1">Direct Line</p>
                    <p class="text-xl font-bold">+91 9505433426</p>
                </div>
                <a href="/contact"
                    class="bg-slate-900 text-white px-8 py-4 rounded text-xs font-bold uppercase tracking-widest">Get
                    Directions</a>
            </div>
        </div>
    </section>

    <!-- 5. FOOTER -->
    <footer class="bg-white border-t border-slate-100 py-20 px-6">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start gap-12">
            <div>
                <h4 class="text-lg font-extrabold tracking-tighter mb-4">AKBAR <span
                        class="text-green-700">BATTERY</span></h4>
                <p class="text-slate-400 text-sm max-w-xs">Authorized dealer for Amaron & Powerzone. Leading energy
                    solutions for the Telangana region.</p>
            </div>
            <div class="grid grid-cols-2 gap-20">
                <div>
                    <h5 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-6">Navigation</h5>
                    <ul class="text-slate-600 text-sm space-y-4 font-medium">
                        <li><a href="/products" class="hover:text-green-700">Inventory</a></li>
                        <li><a href="/about" class="hover:text-green-700">Company</a></li>
                        <li><a href="/contact" class="hover:text-green-700">Contact</a></li>
                    </ul>
                </div>
                <div>
                    <h5 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-6">Support</h5>
                    <ul class="text-slate-600 text-sm space-y-4 font-medium">
                        <li><a href="tel:+919505433426" class="hover:text-green-700">Consultation</a></li>
                        <li><a href="/contact" class="hover:text-green-700">Warranty</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>

</body>

</html>