<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventory | Akbar Battery & Automobiles</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .glass-nav {
            backdrop-filter: blur(20px);
            background: rgba(255, 255, 255, 0.9);
        }

        .product-card:hover img {
            transform: scale(1.03);
        }

        /* Clean transition for professional feel */
        .fade-in {
            animation: fadeIn 0.5s ease-in;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }
    </style>
</head>

<body class="bg-[#F9FAFB] text-slate-900">

    <!-- 1. MINIMALIST NAVIGATION -->
    <nav class="glass-nav sticky top-0 z-[100] border-b border-slate-200 px-6 py-4">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <h1 class="text-xl font-extrabold tracking-tighter text-slate-900">
                AKBAR <span class="text-green-700">BATTERY</span>
            </h1>
            <div class="hidden md:flex space-x-10 text-sm font-semibold uppercase tracking-widest text-slate-500">
                <a href="/" class="hover:text-green-700 transition-colors">Home</a>
                <a href="/products" class="text-slate-900 border-b-2 border-slate-900 pb-1">Inventory</a>
                <a href="/about" class="hover:text-green-700 transition-colors">About</a>
                <a href="/contact" class="hover:text-green-700 transition-colors">Contact</a>
            </div>
        </div>
    </nav>

    <!-- 2. CORPORATE HEADER -->
    <header class="py-16 px-6 bg-white border-b border-slate-100">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-end justify-between gap-8">
            <div class="max-w-2xl">
                <h2 class="text-4xl font-extrabold tracking-tight text-slate-900 mb-4">Commercial Inventory</h2>
                <p class="text-slate-500 text-lg">Sathupally's leading authorized distributor for Amaron & Powerzone
                    energy solutions.</p>
            </div>
            <!-- Sleek Search Bar -->
            <div class="relative w-full md:w-96">
                <input type="text" id="searchInput" onkeyup="filterProducts()" placeholder="Search specifications..."
                    class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-700/20 focus:border-green-700 transition-all">
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-6 py-16">
        <% const sections=['Vehicle', 'Inverter' , 'Lubricant' ]; %>
            <% sections.forEach(section=> { %>
                <% const filteredProducts=products.filter(item=> item.category === section); %>
                    <% if (filteredProducts.length> 0) { %>
                        <div class="section-group mb-20" data-section="<%= section %>">
                            <h3
                                class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400 mb-8 border-b border-slate-100 pb-4">
                                <%= section %> Catalog
                            </h3>

                            <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-8">
                                <% filteredProducts.forEach(item=> { %>
                                    <div class="product-card group cursor-pointer"
                                        data-name="<%= item.name.toLowerCase() %>"
                                        data-brand="<%= item.brand.toLowerCase() %>"
                                        onclick="openProductModal('<%= item.name %>', '<%= item.image %>', '<%= item.price %>', '<%= item.brand %>', '<%= section %>')">

                                        <div
                                            class="aspect-square bg-white border border-slate-100 rounded-xl overflow-hidden mb-4 transition-all duration-500 group-hover:border-slate-300 group-hover:shadow-lg">
                                            <% if (item.image) { %>
                                                <img src="<%= item.image %>"
                                                    class="w-full h-full object-contain p-6 transition-transform duration-700"
                                                    alt="Product">
                                                <% } %>
                                        </div>

                                        <div class="space-y-1">
                                            <p
                                                class="text-[10px] font-bold uppercase tracking-widest <%= item.brand === 'Amaron' ? 'text-green-700' : 'text-amber-600' %>">
                                                <%= item.brand %>
                                            </p>
                                            <h4
                                                class="text-lg font-semibold text-slate-900 group-hover:text-green-700 transition-colors">
                                                <%= item.name %>
                                            </h4>
                                            <p class="text-xl font-light text-slate-900">₹<%= item.price %>
                                            </p>
                                        </div>
                                    </div>
                                    <% }) %>
                            </div>
                        </div>
                        <% } %>
                            <% }) %>
    </main>

    <!-- 3. MINIMALIST FOOTER -->
    <footer class="bg-white border-t border-slate-100 py-20 px-6">
        <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-12">
            <div class="col-span-1 md:col-span-2">
                <h4 class="text-lg font-bold mb-4">Akbar Battery & Automobiles</h4>
                <p class="text-slate-500 max-w-sm">Providing industrial-grade power solutions and expert technical
                    consultation since inception in Sathupally.</p>
            </div>
            <div>
                <h5 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-4">Location</h5>
                <p class="text-slate-600 text-sm">Rajubapaya Hospital Road,<br>T.P.R Residency, Sathupally</p>
            </div>
            <div>
                <h5 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-4">Hours</h5>
                <p class="text-slate-600 text-sm">Mon — Sat: 09:00 - 20:30<br>Sun: Limited Availability</p>
            </div>
        </div>
    </footer>

    <!-- 4. MODAL & WHATSAPP LOGIC (REMAINING CLEAN) -->
    <div id="productModal"
        class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[200] hidden flex items-center justify-center p-6">
        <div class="bg-white max-w-4xl w-full rounded-2xl overflow-hidden shadow-2xl flex flex-col md:flex-row">
            <div class="md:w-1/2 bg-slate-50 p-12 flex items-center justify-center">
                <img id="modalImage" src="" class="max-w-full max-h-72 object-contain" alt="Spec View">
            </div>
            <div class="md:w-1/2 p-12 flex flex-col justify-center relative">
                <button onclick="closeProductModal()"
                    class="absolute top-6 right-6 text-slate-400 hover:text-slate-900 text-2xl">&times;</button>
                <span id="modalBadge" class="text-xs font-bold tracking-[0.2em] uppercase mb-2"></span>
                <h2 id="modalName" class="text-3xl font-bold text-slate-900 mb-6"></h2>
                <div class="text-4xl font-light text-slate-900 mb-10">₹<span id="modalPrice"></span></div>
                <a id="modalWhatsApp" href="" target="_blank"
                    class="bg-slate-900 text-white text-center py-4 rounded font-semibold hover:bg-green-800 transition-all uppercase tracking-widest text-xs">
                    Place Purchase Inquiry
                </a>
            </div>
        </div>
    </div>

    <script>
        function filterProducts() {
            const input = document.getElementById('searchInput').value.toLowerCase();
            const cards = document.querySelectorAll('.product-card');
            const groups = document.querySelectorAll('.section-group');

            cards.forEach(card => {
                const searchTxt = card.getAttribute('data-name') + card.getAttribute('data-brand');
                card.style.display = searchTxt.includes(input) ? 'block' : 'none';
            });

            groups.forEach(group => {
                const visible = group.querySelectorAll('.product-card[style="display: block;"]');
                group.style.display = visible.length > 0 ? 'block' : 'none';
            });
        }

        function openProductModal(name, image, price, brand, category) {
            document.getElementById('modalName').innerText = name;
            document.getElementById('modalImage').src = image || '';
            document.getElementById('modalPrice').innerText = price;
            const badge = document.getElementById('modalBadge');
            badge.innerText = brand + ' // ' + category;
            badge.className = `text-xs font-bold tracking-[0.2em] uppercase mb-2 ${brand === 'Amaron' ? 'text-green-700' : 'text-amber-600'}`;
            document.getElementById('modalWhatsApp').href = `https://wa.me/919505433426?text=Inquiry:%20${encodeURIComponent(name)}`;
            document.getElementById('productModal').classList.remove('hidden');
        }

        function closeProductModal() { document.getElementById('productModal').classList.add('hidden'); }
    </script>
</body>

</html>